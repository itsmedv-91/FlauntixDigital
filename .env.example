# Supabase project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Public URL of the app (used in invite links and auth redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 32-byte key, base64. Generate with: npm run gen:key
# Encrypts client credentials in the vault. Keep it secret and never change it
# after storing credentials, or existing secrets can no longer be decrypted.
CREDENTIALS_ENCRYPTION_KEY=

# Optional. Powers the AI assistant at /assistant (Claude).
# Get one from https://console.anthropic.com/. Without it the assistant page
# explains how to switch it on and nothing else is affected.
ANTHROPIC_API_KEY=
